PORT=5000
NODE_ENV=development

# Supabase project credentials.
# SUPABASE_SECRET_KEY is the service-role key: it bypasses Row Level Security,
# so treat it like a root password and never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Secret used to sign room access tokens and host tokens. REQUIRED — the server
# refuses to start without it, and it must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Comma-separated list of browser origins allowed to call this API.
# Required in production: requests from other origins are rejected.
# e.g. https://stash-ed.vercel.app,https://stash.yourdomain.com
ALLOWED_ORIGINS=

# ──────────────────────────────────────────────────────────────────────────
# Billing (optional)
#
# Stash runs perfectly with none of this set: the server simply serves every
# request on the Free plan and the pricing page's checkout buttons report that
# checkout is unconfigured.
# ──────────────────────────────────────────────────────────────────────────

# Set to true when running your own instance. Lifts every plan limit for
# everyone on this server and disables usage metering entirely. This is the
# intended setting for self-hosters — the MIT licence gives you the code, and
# metering your own hardware would serve no one.
SELF_HOSTED_UNLIMITED=false

# Secret used to sign and verify license keys. Keep it separate from
# TOKEN_SECRET: room tokens are minted constantly for anonymous visitors,
# licenses are money, and a leak of one must not mint the other.
# Falls back to TOKEN_SECRET if unset. Min 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_SECRET=

# Hosted checkout URLs from your payment provider (Lemon Squeezy, Paddle).
# A merchant of record is strongly recommended over raw Stripe: it handles VAT
# and sales tax registration in every jurisdiction you sell into.
CHECKOUT_URL_PRO=
CHECKOUT_URL_TEAM=

# Shared secret used to verify the provider's webhook signature. Without it the
# webhook rejects every request, which is the correct default: an unverified
# billing webhook mints licenses for anyone who finds the URL.
BILLING_WEBHOOK_SECRET=

# Enables POST /api/billing/admin/mint for comps, refunds and press keys.
# Unset (or under 16 chars) disables the route entirely rather than opening it.
ADMIN_SECRET=

# Comma-separated license keys to reject after a refund or chargeback.
REVOKED_LICENSE_KEYS=
