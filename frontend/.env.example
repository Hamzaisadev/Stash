# Origin of the deployed backend (no trailing slash).
# REQUIRED for production builds. Without it the frontend falls back to its own
# origin, where /api/* returns the SPA shell instead of JSON — the app appears
# to deploy fine but cannot upload anything.
VITE_BACKEND_URL=https://your-backend.up.railway.app

# Optional TURN relay for WebRTC (P2P file transfer and screen share).
# STUN alone fails behind symmetric NAT — most mobile carriers and many
# corporate networks — so without these, those features fail for many users.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
